// SPDX-License-Identifier: GPL-3.0-or-later
// Resources of the game exe: the manifest (UTF-8 code page, long paths, asInvoker), the icon and the version information.
// GAME_VER_MAJOR / MINOR / PATCH and GAME_VER_TEXT come from the build (game-build/CMakeLists.txt, -DGAME_VERSION=0.1.0; the package
// build prepends them). Names come from the game manifest through game_manifest.h; game.manifest is game.manifest.in with the product name filled in.
#include <winres.h>
#include "game_manifest.h"

#ifndef GAME_VER_MAJOR
#define GAME_VER_MAJOR 0
#define GAME_VER_MINOR 0
#define GAME_VER_PATCH 0
#endif
#ifndef GAME_VER_TEXT
#define GAME_VER_TEXT "dev"
#endif

1 24 "game.manifest"

// The exe's icon (the first icon group: Explorer, the window and taskbar through SDL's INTRESOURCE hint, the Windows volume mixer).
// Neutral art drawn by make_icon.py.
1 ICON "game.ico"

1 VERSIONINFO
FILEVERSION     GAME_VER_MAJOR, GAME_VER_MINOR, GAME_VER_PATCH, 0
PRODUCTVERSION  GAME_VER_MAJOR, GAME_VER_MINOR, GAME_VER_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", ""
            VALUE "FileDescription", GAME_PRODUCT
            VALUE "FileVersion", GAME_VER_TEXT
            VALUE "InternalName", GAME_ID
            VALUE "OriginalFilename", GAME_EXE
            VALUE "ProductName", GAME_PRODUCT
            VALUE "ProductVersion", GAME_VER_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
