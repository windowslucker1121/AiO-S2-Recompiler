// SPDX-License-Identifier: GPL-3.0-or-later
// Resources of the Initial Setup exe (runtime/apps/setup): its manifest (common controls v6, per-monitor DPI, UTF-8, asInvoker) and version info.
#include <winres.h>
#include "game_manifest.h"

#ifndef GAME_VER_MAJOR
#define GAME_VER_MAJOR 0
#define GAME_VER_MINOR 0
#define GAME_VER_PATCH 0
#endif
#ifndef GAME_VER_TEXT
#define GAME_VER_TEXT "dev"
#endif

1 24 "setup.manifest"

1 VERSIONINFO
FILEVERSION     GAME_VER_MAJOR, GAME_VER_MINOR, GAME_VER_PATCH, 0
PRODUCTVERSION  GAME_VER_MAJOR, GAME_VER_MINOR, GAME_VER_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", ""
            VALUE "FileDescription", GAME_PRODUCT " setup"
            VALUE "FileVersion", GAME_VER_TEXT
            VALUE "InternalName", GAME_ID "_setup"
            VALUE "OriginalFilename", GAME_SETUP_EXE
            VALUE "ProductName", GAME_PRODUCT
            VALUE "ProductVersion", GAME_VER_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
