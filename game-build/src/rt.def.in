; The runtime DLL's exports (release model b): the entry the game exe calls (rt_api.h) and every function recomp's ctx.h marks as
; runtime-provided, which the lifted game code compiled on the player's PC imports from here. @GAME_RT_STEM@ comes from the game manifest.
LIBRARY @GAME_RT_STEM@
EXPORTS
    game_rt_main
    call_indirect
    host_import
    guest_trap
    guest_unimpl
    guest_svc
    guest_mrs
    guest_msr
    nx_site_inline
    nx_site_midhook
    nx_hook_entry
    stx_diag
    nx_catch_call
    nx_icall_miss
    nx_iimport_miss
