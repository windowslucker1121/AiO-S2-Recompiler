# Writes OUT (gen/build_id.h of the game exe) with the commit of the checkout ROOT and whether tracked files had uncommitted changes,
# only when that changed (so game_main.cpp recompiles only after a commit or a change of the dirty state). Run with cmake -P at every
# build (target game_build_id) and once at configure time. GIT: the git executable (empty: no git, the commit stays empty).
set(_commit "")
set(_dirty 0)
if(GIT)
    execute_process(COMMAND "${GIT}" -C "${ROOT}" rev-parse HEAD OUTPUT_VARIABLE _commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET
                    RESULT_VARIABLE _rc)
    if(NOT _rc EQUAL 0)
        set(_commit "")
    else()
        execute_process(COMMAND "${GIT}" -C "${ROOT}" status --porcelain --untracked-files=no OUTPUT_VARIABLE _st ERROR_QUIET)
        if(_st)
            set(_dirty 1)
        endif()
    endif()
endif()
set(_text "// generated by game-build/cmake/build_id.cmake\n#define GAME_BUILD_COMMIT \"${_commit}\"\n#define GAME_BUILD_DIRTY ${_dirty}\n")
set(_old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _text)
    file(WRITE "${OUT}" "${_text}")
endif()
