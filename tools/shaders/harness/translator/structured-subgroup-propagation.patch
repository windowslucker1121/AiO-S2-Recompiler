+            // A cross-lane operation (ballot, vote, shuffle) depends on which lanes run it: folded into a use inside another block (an
+            // if that only some lanes enter) it runs with those lanes only (structured-subgroup-propagation.patch). It is propagated only
+            // into the next statements of the same block, as a memory read is, with no block in between.
+            bool readsLanes = ReadsLanes(assignment.Source);
+
+            if (!readsLanes && !ReadsMemory(assignment.Source))
             {
                 return false;
             }
