         private static SpvInstruction GetStoragePointer(CodeGenContext context, AstOperation operation, out AggregateType varType)
         {
             StorageKind storageKind = operation.StorageKind;
+
+            if (storageKind == StorageKind.GlobalMemory)   // a device address the pool address table gave (AmpereGlobal.cs, A17)
+            {
+                return AmpereGlobal.DevicePointer(context, operation, out varType);
