Ryujinx SPIR-V back end, task/mesh hooks (tools/shaders/ampere/frontend/AmpereMesh.cs): a return of main first emits the
hardware end of a task or mesh program (EmitMeshTasksEXT / SetMeshOutputsEXT and the output copies), and a shared memory access
to the task payload region uses the TaskPayloadWorkgroupEXT storage class. Also the Ampere front end's cooperative-matrix
instruction (HMMA, tools/shaders/ampere/frontend/AmpereCoopMat.cs). The Ryujinx code in the context lines is MIT.

--- a/CodeGen/Spirv/Instructions.cs
+++ b/CodeGen/Spirv/Instructions.cs
@@ -143,6 +143,7 @@
             Add(Instruction.VoteAll,                  GenerateVoteAll);
             Add(Instruction.VoteAllEqual,             GenerateVoteAllEqual);
             Add(Instruction.VoteAny,                  GenerateVoteAny);
+            Add(Instruction.CooperativeMatrixMulAdd,  AmpereCoopMat.GenerateMulAdd);   // HMMA (ampere/frontend/AmpereCoopMat.cs)
 #pragma warning restore IDE0055
         }

@@ -1049,7 +1050,7 @@
             {
                 context.ReturnValue(context.Get(context.CurrentFunction.ReturnType, operation.GetSource(0)));
             }
-            else
+            else if (!(context.IsMainFunction && AmpereMesh.EmitEpilogue(context)))   // task/mesh: the hardware's end of program first (AmpereMesh.cs)
             {
                 context.Return();
             }
@@ -1659,14 +1660,19 @@
         {
             SpvInstruction pointer = GetStoragePointer(context, operation, out AggregateType varType);
 
+            bool device = operation.StorageKind == StorageKind.GlobalMemory;   // PhysicalStorageBuffer accesses need an alignment (AmpereGlobal.cs)
+
             if (isStore)
             {
-                context.Store(pointer, context.Get(varType, operation.GetSource(operation.SourcesCount - 1)));
+                SpvInstruction st = device ? context.Store(pointer, context.Get(varType, operation.GetSource(operation.SourcesCount - 1)), MemoryAccessMask.Aligned)
+                                           : context.Store(pointer, context.Get(varType, operation.GetSource(operation.SourcesCount - 1)));
+                if (device) st.AddOperand((Spv.Generator.LiteralInteger)4);
                 return OperationResult.Invalid;
             }
             else
             {
-                SpvInstruction result = context.Load(context.GetType(varType), pointer);
+                SpvInstruction result = device ? context.Load(context.GetType(varType), pointer, MemoryAccessMask.Aligned) : context.Load(context.GetType(varType), pointer);
+                if (device) result.AddOperand((Spv.Generator.LiteralInteger)4);
                 return new OperationResult(varType, result);
             }
         }
