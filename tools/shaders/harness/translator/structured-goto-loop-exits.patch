+        // Gotos are eliminated last to first, so a goto that left a loop earlier (MoveOutward: "if (c) break;" before
+        // the loop's end, the goto moved after the loop) may already sit in the statements a later goto encloses in a
+        // new do-while. That break (or continue) would then leave (or restart) the new loop instead of the loop it was
+        // made for, and control falls back into the old loop: an endless loop when it was the loop's only exit (the game A8,
+        // the light loop of the material shaders). Exits that belong to an outer loop leave the new loop with a flag
+        // set, and the flag repeats them right after it ("if (flag) { flag = false; break; }"). The flag is cleared at
+        // the start of the function and where it is used, not before the new loop: later gotos may put an "if (!c)"
+        // around the statements before the loop (MoveInward), and a cleared-there flag would then be stale or undefined.
+        private static void RetargetLoopExits(AstBlock loop, Func<AggregateType, AstOperand> newTemp)
+        {
+            List<AstOperation> exits = [];
+
+            CollectLoopExits(loop, exits);
+
+            if (exits.Count == 0)
+            {
+                return;
+            }
+
+            AstBlock parent = loop.Parent;
+            AstBlock mainBlock = parent;
+
+            while (mainBlock.Parent != null)
+            {
+                mainBlock = mainBlock.Parent;
+            }
+
+            AstOperand breakFlag = null;
+            AstOperand continueFlag = null;
+
+            foreach (AstOperation exit in exits)
+            {
+                AstBlock exitBlock = exit.Parent;
+
+                if (exit.Inst == Instruction.LoopBreak)
+                {
+                    breakFlag ??= newTemp(AggregateType.Bool);
+
+                    exitBlock.AddBefore(exit, Assign(breakFlag, Const(IrConsts.True)));
+                }
+                else
+                {
+                    continueFlag ??= newTemp(AggregateType.Bool);
+
+                    exitBlock.AddBefore(exit, Assign(continueFlag, Const(IrConsts.True)));
+                    exitBlock.AddBefore(exit, new AstOperation(Instruction.LoopBreak));
+                    exitBlock.Remove(exit);
+                }
+            }
+
+            IAstNode last = loop;
+
+            foreach ((AstOperand flag, Instruction inst) in new[] { (breakFlag, Instruction.LoopBreak), (continueFlag, Instruction.LoopContinue) })
+            {
+                if (flag == null)
+                {
+                    continue;
+                }
+
+                mainBlock.AddFirst(Assign(flag, Const(IrConsts.False)));
+
+                AstBlock repeat = new(AstBlockType.If, flag);
+
+                repeat.Add(Assign(flag, Const(IrConsts.False)));
+                repeat.Add(new AstOperation(inst));
+
+                parent.AddAfter(last, repeat);
+
+                last = repeat;
+            }
+        }
+
+        // Breaks and continues in the block that are not inside a loop nested in it.
+        private static void CollectLoopExits(AstBlock block, List<AstOperation> exits)
+        {
+            foreach (IAstNode node in block)
+            {
+                if (node is AstBlock child)
+                {
+                    if (child.Type != AstBlockType.DoWhile && child.Type != AstBlockType.While)
+                    {
+                        CollectLoopExits(child, exits);
+                    }
+                }
+                else if (node is AstOperation operation && (operation.Inst == Instruction.LoopBreak || operation.Inst == Instruction.LoopContinue))
+                {
+                    exits.Add(operation);
+                }
+            }
         }
 
