+                foreach (int word in fallback) targetCbs.Add(PackCbSlotAndOffset(0, word));
+                AmpereGlobal.Used = true;
+                gpuAccessor.Log($"Global memory fallback for operation \"{operation.Inst}\": {fallback.Length} storage descriptors checked at run time.");
