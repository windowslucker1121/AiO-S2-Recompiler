                     }
 
-                    if (IsGlobalMemory(operation.StorageKind))
+                    if (IsGlobalMemory(operation.StorageKind) && !AmpereGlobal.IsDeviceAddressOp(operation))   // device address accesses stay global (AmpereGlobal.cs)
                     {
                         LinkedListNode<INode> nextNode = ReplaceGlobalMemoryWithStorage(
                             gtsContext,
@@ -653,6 +653,16 @@
 
