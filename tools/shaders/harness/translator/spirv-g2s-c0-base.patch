+            Operand[] fast = AmpereGlobal.EmitFastOperands(operation);
+            Operand returnValue = Local();
+            Operand[] outs = new Operand[AmpereGlobal.FastOuts];
+            Operand[] dests = new Operand[1 + outs.Length];
+            dests[0] = returnValue;
+            for (int i = 0; i < outs.Length; i++) dests[1 + i] = outs[i] = Local();
+            Operand[] sources = new Operand[3 + fast.Length];
+            sources[0] = Const(functionId);
+            sources[1] = operation.GetSource(0);
+            sources[2] = operation.GetSource(1);
+            fast.CopyTo(sources, 3);
+            Operation callOp = new(Instruction.Call, 0, dests, sources);
+            node.List.AddBefore(node, callOp);
+            operation.TurnIntoCopy(returnValue);
+            return node;
         }
 
