#
# Reader of a game manifest (recomp/games/<id>/game.toml) for CMake.
#
#   include(GameManifest.cmake)
#   game_manifest_load("<path>/game.toml")                sets GM_<table>_<key> (and GM_<array>_<n>_<key> for [[array]] tables)
#   game_manifest_header("<out dir>/game_manifest.h")     writes the GAME_* macros the C++ side uses (written only when the text changes)
#
# Subset of TOML understood: comments, [table], [dotted.table], [[array.of.tables]], key = "string" | integer | 0xHEX | true | false.
# Strings must not contain quotes or backslashes. Dotted names become underscores: [[dump.file]] is GM_dump_file_<n>_<key>.
# Derived: GM_ID, GM_ID_UPPER, GM_MODULE_COUNT, GM_MODULES (names in lifter order), GM_LOAD_ORDER (names, entry module first),
# GM_MODULE_LIBS (the per-module library target names <id>_<name>), GM_MANIFEST_FILE.
# The Python side of the same file: tomllib (config.py, release_b/game_build.py); the launcher: the toml crate.

macro(game_manifest_load _gm_file)
    if(NOT EXISTS "${_gm_file}")
        message(FATAL_ERROR "game manifest not found: ${_gm_file}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_gm_file}")
    set(GM_MANIFEST_FILE "${_gm_file}")
    file(READ "${_gm_file}" _gm_text)
    # keep the list machinery away from ; [ ] inside lines
    string(REPLACE ";" "@@SC@@" _gm_text "${_gm_text}")
    string(REPLACE "[" "@@LB@@" _gm_text "${_gm_text}")
    string(REPLACE "]" "@@RB@@" _gm_text "${_gm_text}")
    string(REPLACE "\r" "" _gm_text "${_gm_text}")
    string(REPLACE "\n" ";" _gm_lines "${_gm_text}")
    set(_gm_sec "")
    set(_gm_arrays "")
    foreach(_gm_l IN LISTS _gm_lines)
        if(_gm_l MATCHES "^[ \t]*#" OR _gm_l MATCHES "^[ \t]*$")
            continue()
        elseif(_gm_l MATCHES "^[ \t]*@@LB@@@@LB@@([A-Za-z0-9_.]+)@@RB@@@@RB@@")
            string(REPLACE "." "_" _gm_name "${CMAKE_MATCH_1}")
            if(NOT DEFINED GM_COUNT_${_gm_name})
                set(GM_COUNT_${_gm_name} 0)
                list(APPEND _gm_arrays "${_gm_name}")
            else()
                math(EXPR GM_COUNT_${_gm_name} "${GM_COUNT_${_gm_name}} + 1")
            endif()
            set(_gm_sec "${_gm_name}_${GM_COUNT_${_gm_name}}_")
        elseif(_gm_l MATCHES "^[ \t]*@@LB@@([A-Za-z0-9_.]+)@@RB@@")
            string(REPLACE "." "_" _gm_name "${CMAKE_MATCH_1}")
            set(_gm_sec "${_gm_name}_")
        elseif(_gm_l MATCHES "^[ \t]*([A-Za-z0-9_]+)[ \t]*=[ \t]*\"([^\"]*)\"")
            set(_gm_key "${CMAKE_MATCH_1}")
            set(_gm_val "${CMAKE_MATCH_2}")
            if(_gm_val MATCHES "\\\\")
                message(FATAL_ERROR "${_gm_file}: backslash in the value of ${_gm_key}")
            endif()
            string(REPLACE "@@SC@@" ";" _gm_val "${_gm_val}")
            string(REPLACE "@@LB@@" "[" _gm_val "${_gm_val}")
            string(REPLACE "@@RB@@" "]" _gm_val "${_gm_val}")
            set(GM_${_gm_sec}${_gm_key} "${_gm_val}")
        elseif(_gm_l MATCHES "^[ \t]*([A-Za-z0-9_]+)[ \t]*=[ \t]*(0x[0-9a-fA-F]+|[0-9]+|true|false)([ \t]|$)")
            set(GM_${_gm_sec}${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
        else()
            message(FATAL_ERROR "${_gm_file}: cannot read the line: ${_gm_l}")
        endif()
    endforeach()

    set(GM_ID "${GM_game_id}")
    string(TOUPPER "${GM_ID}" GM_ID_UPPER)
    if(NOT DEFINED GM_COUNT_module)
        message(FATAL_ERROR "${_gm_file}: no [[module]]")
    endif()
    math(EXPR GM_MODULE_COUNT "${GM_COUNT_module} + 1")
    set(GM_MODULES "")
    set(GM_MODULE_LIBS "")
    set(_gm_entry "")
    set(_gm_rest "")
    math(EXPR _gm_last "${GM_MODULE_COUNT} - 1")
    foreach(_gm_i RANGE ${_gm_last})
        list(APPEND GM_MODULES "${GM_module_${_gm_i}_name}")
        list(APPEND GM_MODULE_LIBS "${GM_ID}_${GM_module_${_gm_i}_name}")
        if(GM_module_${_gm_i}_entry)
            list(APPEND _gm_entry "${_gm_i}")
        else()
            list(APPEND _gm_rest "${_gm_i}")
        endif()
    endforeach()
    set(GM_LOAD_ORDER_IDX ${_gm_entry} ${_gm_rest})
    set(GM_LOAD_ORDER "")
    foreach(_gm_i IN LISTS GM_LOAD_ORDER_IDX)
        list(APPEND GM_LOAD_ORDER "${GM_module_${_gm_i}_name}")
    endforeach()
    get_filename_component(GM_RT_STEM "${GM_files_runtime_dll}" NAME_WE)
    get_filename_component(GM_EXE_STEM "${GM_files_exe}" NAME_WE)
endmacro()

function(game_manifest_header _gm_out)
    set(_h "// Generated from the game manifest (${GM_MANIFEST_FILE}) by recomp/cmake/GameManifest.cmake. Do not edit.\n#pragma once\n")
    macro(_gm_str _name _val)
        string(APPEND _h "#define ${_name} \"${_val}\"\n")
    endmacro()
    _gm_str(GAME_ID "${GM_ID}")
    _gm_str(GAME_ID_UPPER "${GM_ID_UPPER}")
    _gm_str(GAME_TITLE "${GM_game_title}")
    _gm_str(GAME_SHORT_TITLE "${GM_game_short_title}")
    _gm_str(GAME_PRODUCT "${GM_game_product}")
    _gm_str(GAME_TITLE_ID "${GM_game_title_id}")
    _gm_str(GAME_TARGET_VERSION "${GM_game_version}")
    string(APPEND _h "#define GAME_PROGRAM_ID 0x${GM_game_title_id}ull\n")
    string(APPEND _h "#define GAME_LANGUAGES ${GM_game_languages}u\n")
    if(GM_game_platform STREQUAL "switch2")
        string(APPEND _h "#define GAME_PLATFORM Switch2\n")
    else()
        string(APPEND _h "#define GAME_PLATFORM Switch1\n")
    endif()
    _gm_str(GAME_EXE "${GM_files_exe}")
    _gm_str(GAME_RT_DLL "${GM_files_runtime_dll}")
    _gm_str(GAME_INI "${GM_files_ini}")
    _gm_str(GAME_LOG "${GM_files_log}")
    _gm_str(GAME_SETUP_EXE "${GM_files_setup_exe}")
    _gm_str(GAME_LAUNCHER_INI "${GM_files_launcher_ini}")
    _gm_str(GAME_SHADER_PACK "${GM_files_shader_pack}")
    _gm_str(GAME_SAVE_FOLDER "${GM_files_save_folder}")
    _gm_str(GAME_DUMP_VERSION "${GM_dump_version}")              # the dump the release is made for (the setup tool shows it)
    _gm_str(GAME_MAIN_BUILD_ID "${GM_dump_main_build_id}")       # build id of that dump's main (hex): the setup tool compares the player's
    string(APPEND _h "#define GAME_ENV(name) GAME_ID_UPPER \"_\" name\n")
    string(APPEND _h "#define GAME_HEADER \"${GM_ID}/${GM_ID}_game.h\"\n")
    string(APPEND _h "#define GAME_REGISTER nxrt_register_game_${GM_ID}\n")
    string(APPEND _h "#define GAME_REGISTER_DATA nxrt_register_game_${GM_ID}_data\n")
    # main's base: hook offsets are relative to it
    foreach(_i RANGE ${GM_COUNT_module})
        if(GM_module_${_i}_name STREQUAL "main")
            string(APPEND _h "#define GAME_MAIN_BASE ${GM_module_${_i}_base}ull\n")
        endif()
    endforeach()
    # X(name, nso file, guest base): the modules in the order the runtime maps them (entry module first)
    string(APPEND _h "#define GAME_MODULES(X)")
    foreach(_n IN LISTS GM_LOAD_ORDER)
        foreach(_i RANGE ${GM_COUNT_module})
            if(GM_module_${_i}_name STREQUAL "${_n}")
                string(APPEND _h " \\\n    X(${_n}, \"${GM_module_${_i}_file}\", ${GM_module_${_i}_base}ull)")
            endif()
        endforeach()
    endforeach()
    string(APPEND _h "\n")
    set(_old "")
    if(EXISTS "${_gm_out}")
        file(READ "${_gm_out}" _old)
    endif()
    if(NOT _old STREQUAL _h)
        file(WRITE "${_gm_out}" "${_h}")
    endif()
endfunction()
