// Resources of the Ocarina of Time launcher (mpr_launcher.exe; cmake/launcher.cmake takes them from the game module): manifest (Common Controls 6, per-monitor DPI, UTF-8, asInvoker) and version info.
#include <winres.h>

1 24 "launcher.manifest"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", ""
            VALUE "FileDescription", "Ocarina of Time PC - Launcher"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "mpr_launcher"
            VALUE "OriginalFilename", "mpr_launcher.exe"
            VALUE "ProductName", "Ocarina of Time PC - Launcher"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
